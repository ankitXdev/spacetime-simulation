<?xml version="1.0" encoding="UTF-8"?>

<!--
    The <project> element is the root of the Maven configuration.
    Everything about the Maven project goes inside this element.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Version of the Maven POM format -->
    <modelVersion>4.0.0</modelVersion>


    <!-- Identifies your project -->
    <groupId>com.ankit</groupId>

    <!-- Name/ID of the project -->
    <artifactId>gravitational-pull-project</artifactId>

    <!-- Version of your project -->
    <version>1.0-SNAPSHOT</version>


    <!--
        Project-wide settings.
        These values can be reused elsewhere in the pom.xml.
    -->
    <properties>

        <!-- Tell Maven to compile the project using Java 26 -->
        <maven.compiler.release>26</maven.compiler.release>

        <!-- Character encoding used by the source files -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- JavaFX version we want to use -->
        <javafx.version>26</javafx.version>

    </properties>


    <!--
        Dependencies are external libraries that your project needs.
        Maven automatically downloads them.
    -->
    <dependencies>
        <!-- LWJGL -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <version>3.3.6</version>
        </dependency>


        <!-- LWJGL Windows native -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <version>3.3.6</version>
            <classifier>natives-windows</classifier>
        </dependency>

        <!-- GLFW -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
            <version>3.3.6</version>
        </dependency>

        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
            <version>3.3.6</version>
            <classifier>natives-windows</classifier>
        </dependency>

        <!-- OpenGL -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
            <version>3.3.6</version>
        </dependency>

        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
            <version>3.3.6</version>
            <classifier>natives-windows</classifier>
        </dependency>

    </dependencies>


    <!-- Build configuration -->
    <build>

        <plugins>


        </plugins>

    </build>

</project>